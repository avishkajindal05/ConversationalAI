# ─── English Coach Environment Configuration ───
LOG_LEVEL=INFO
OLLAMA_HOST=http://localhost:11434
# Conversation graph — larger model for natural dialogue
CONVERSATION_MODEL=qwen3:8b-instruct-q4
# Evaluation scoring (grammar/vocabulary/fluency/engagement/confidence) — lighter, faster
SCORING_MODEL=llama3.2
# Evaluation reasoning (recommendation/report) — larger model for richer generation
REASONING_MODEL=qwen3:8b-instruct-q4
WHISPER_MODEL=small
PIPER_MODEL=en_US-lessac-medium
DATABASE_PATH=data/english_coach.db
API_BASE_URL=http://localhost:8000
